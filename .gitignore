# Only what git tracks is linked into place (see `rice link`), file by file,
# so application data cannot land in the repo — except inside the three
# directories linked whole: quickshell/, niri/ and nvim/. What those write
# is listed here.

# ── niri ─────────────────────────────────────────────────────────────────
# NiriTheme and Keybinds copy config.kdl aside before rewriting it.
*.bak
config/niri/config.kdl.qs-backup
config/niri/config.kdl.qs-theme-backup
config/niri/config.kdl.pre-renumber

# ── nvim ─────────────────────────────────────────────────────────────────
config/nvim/lazy/
config/nvim/spell/

# ── Python bytecode ──────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Machine-specific ─────────────────────────────────────────────────────
# Filesystem UUIDs unique to one laptop: useless to anyone cloning, and a
# stable fingerprint of the hardware if published. The flake reads the
# machine's own /etc/nixos/hardware-configuration.nix instead.
nixos/hardware-configuration.nix
