# ── Secrets ──────────────────────────────────────────────────────────────
# obs-websocket stores its server password in plain text. The rest of the OBS
# config is tracked; this one file must never be.
config/obs-studio/plugin_config/obs-websocket/config.json

# ── Generated by the shell ───────────────────────────────────────────────
# Outputs, not inputs. The bar rewrites these whenever the accent or flavour
# moves, so tracking them means a permanently dirty tree and diffs full of
# colour churn. Each carries a "do not edit" header naming its writer, and
# each is regenerated on first run.
#
#   kitty/colors.conf  <- services/KittyTheme.qml
config/kitty/colors.conf

# ── Application state ────────────────────────────────────────────────────
config/obs-studio/logs/
config/obs-studio/profiler_data/
config/obs-studio/plugin_config/rtmp-services/
config/nvim/lazy/
config/nvim/spell/

# ── Backups ──────────────────────────────────────────────────────────────
# NiriTheme and Keybinds copy config.kdl aside before rewriting it.
*.bak
config/niri/config.kdl.qs-backup
config/niri/config.kdl.qs-theme-backup
config/niri/config.kdl.pre-renumber

# Auto-generated by its package, and pins a versioned /nix/store path that
# goes stale on every update.
local/share/applications/claude-code-url-handler.desktop
