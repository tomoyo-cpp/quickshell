#!/usr/bin/env python3
"""Install and colour the spicetify `text` theme from the quickshell bar's palette.

`text` is the minimal theme from github.com/spicetify/spicetify-themes — track
lists as plain text, no cards, no gradients. It ships CatppuccinMocha,
CatppuccinMacchiato and CatppuccinLatte schemes, but those hardcode mauve as
the accent and there is no Frappe at all. So rather than pick one, this writes
a `[bar]` scheme built from whatever the Appearance tab is actually set to —
all four flavours, all sixteen accents.

    spotify-theme                    regenerate the [bar] scheme
    spotify-theme --apply            regenerate and re-patch Spotify
    spotify-theme --accent text      pin one accent, ignoring the bar
    spotify-theme --accent auto      follow the bar's accent again
    spotify-theme --update-theme     re-fetch `text` from upstream

The accent pin lives in ~/.config/spicetify/accent-override so plain runs keep
honouring it. Restarting is never done from here — spicetify's own restart
kills playback without warning:

    systemctl --user restart spotify-spiced
"""

import configparser
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
SPICE = f"{HOME}/.config/spicetify"
THEME_DIR = f"{SPICE}/Themes/text"
OVERRIDE = f"{SPICE}/accent-override"
UPSTREAM = "https://github.com/spicetify/spicetify-themes.git"
SCHEME = "bar"

MARKER = "/* ── quickshell additions ──"
TRANSPARENT_FLAG = f"{SPICE}/transparent"

# Appended to the theme's own user.css, and ONLY when transparency is turned on
# — which it is not by default, because it does not work here.
#
# Measured rather than assumed: with this applied, body, #main,
# .Root__top-container and .Root__nav-bar all compute to rgba(0,0,0,0). Spotify
# is CEF, CEF never asked the compositor for a translucent visual, so those
# surfaces render black instead of showing the wallpaper — and the whole client
# looks unthemed. The theme's own #24273a never gets painted.
#
# Kept behind `--transparent on` in case a future Spotify/CEF build does
# request an alpha visual, at which point this becomes correct rather than
# destructive.
EXTRA_CSS = f"""
{MARKER} ────────────────────────────────────
 * Written by spotify-theme --transparent on. Edit there, not here.
 */
:is(
  #main,
  body,
  .Root__top-container,
  .Root__main-view,
  .Root__nav-bar,
  .Root__now-playing-bar,
  .main-view-container__scroll-node,
  .main-nowPlayingBar-nowPlayingBar,
  .main-yourLibraryX-library
) {{
  background-color: transparent !important;
}}

/* Things that have to stay readable keep a surface of their own. */
.main-contextMenu-menu,
.main-trackCreditsModal-container,
.GenericModal {{
  background-color: var(--spice-main) !important;
}}
"""

PALETTES = {
    "mocha": {
        "rosewater": "f5e0dc", "flamingo": "f2cdcd", "pink": "f5c2e7",
        "mauve": "cba6f7", "red": "f38ba8", "maroon": "eba0ac",
        "peach": "fab387", "yellow": "f9e2af", "green": "a6e3a1",
        "teal": "94e2d5", "sky": "89dceb", "sapphire": "74c7ec",
