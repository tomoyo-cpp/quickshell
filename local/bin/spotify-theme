        "overlay1": "8c8fa1", "overlay0": "9ca0b0", "surface2": "acb0be",
        "surface1": "bcc0cc", "surface0": "ccd0da", "base": "eff1f5",
        "mantle": "e6e9ef", "crust": "dce0e8",
    },
}


def bar_settings(argv):
    """Whatever the Appearance tab is currently set to.

    --flavour / --use-accent take precedence over the file. The shell passes
    them because it knows the new values before they reach disk: Settings
    debounces its writes by 400ms, so a caller triggered by the change and
    reading the file back would race it and apply the previous accent. That is
    not a hypothetical — the service's own debounce was shorter, so it lost
    that race every single time.
    """
    flavour = accent = None
    if "--flavour" in argv:
        flavour = argv[argv.index("--flavour") + 1]
    if "--use-accent" in argv:
        accent = argv[argv.index("--use-accent") + 1]
    if flavour and accent:
        return flavour, accent

    hits = glob.glob(f"{HOME}/.local/state/quickshell/by-shell/*/settings.json")
    if not hits:
        return flavour or "mocha", accent or "text"
    with open(max(hits, key=os.path.getmtime)) as fh:
        data = json.load(fh)
    return flavour or data.get("flavour", "mocha"), accent or data.get("accent", "text")


def install_theme(force=False):
    if os.path.isdir(THEME_DIR) and not force:
        return
    print("fetching `text` from spicetify-themes…", flush=True)
    with tempfile.TemporaryDirectory() as tmp:
        subprocess.run(
            ["git", "clone", "--depth", "1", "--quiet", UPSTREAM, f"{tmp}/themes"],
            check=True,
        )
        shutil.rmtree(THEME_DIR, ignore_errors=True)
        os.makedirs(os.path.dirname(THEME_DIR), exist_ok=True)
        shutil.copytree(f"{tmp}/themes/text", THEME_DIR)

    print(f"installed -> {THEME_DIR}", flush=True)


def apply_transparency(argv):
    """Add or strip the transparency block. Off unless explicitly turned on."""
    if "--transparent" in argv:
        want = argv[argv.index("--transparent") + 1] == "on"
        os.makedirs(SPICE, exist_ok=True)
        if want:
            open(TRANSPARENT_FLAG, "w").close()
        elif os.path.exists(TRANSPARENT_FLAG):
            os.remove(TRANSPARENT_FLAG)
    else:
        want = os.path.exists(TRANSPARENT_FLAG)

    css = f"{THEME_DIR}/user.css"
    if not os.path.exists(css):
        return want
    with open(css) as fh:
        body = fh.read()
    # Always rebuild from the block-free text, so toggling either way is clean
    # and re-running never stacks up copies.
    base = body.split(MARKER)[0].rstrip() + "\n"
    new = base + EXTRA_CSS if want else base
    if new != body:
        with open(css, "w") as fh:
            fh.write(new)
    return want


def accent_override(argv):
    """Read, set or clear the pinned accent. Returns the pin, or None."""
    if "--accent" in argv:
        want = argv[argv.index("--accent") + 1]
        os.makedirs(SPICE, exist_ok=True)
        if want == "auto":
            if os.path.exists(OVERRIDE):
                os.remove(OVERRIDE)
            return None
        with open(OVERRIDE, "w") as fh:
            fh.write(want)
        return want
    if os.path.exists(OVERRIDE):
        with open(OVERRIDE) as fh:
            return fh.read().strip() or None
    return None


def main():
    install_theme(force="--update-theme" in sys.argv)
    transparent = apply_transparency(sys.argv)

    flavour, accent = bar_settings(sys.argv)
    palette = PALETTES.get(flavour, PALETTES["mocha"])

    pinned = accent_override(sys.argv)
    if pinned:
        accent = pinned

    # "black" is the bar's name for a neutral accent and has no Catppuccin
    # entry; fall back to the foreground colour.
    key = accent if accent in palette else "text"
    hi = palette[key]

    # `text` uses its own key names — nothing like the generic spicetify set.
    ini = configparser.ConfigParser()
    ini.optionxform = str
    ini.read(f"{THEME_DIR}/color.ini")
    ini[SCHEME] = {
        "accent": hi,
        "accent-active": hi,
        "accent-inactive": palette["base"],
        "banner": hi,
        "border-active": hi,
        "border-inactive": palette["surface0"],
        "header": palette["surface2"],
        "highlight": palette["surface2"],
        "main": palette["base"],
        "notification": palette["blue"],
        "notification-error": palette["red"],
        "subtext": palette["subtext0"],
        "text": palette["text"],
    }
    with open(f"{THEME_DIR}/color.ini", "w") as fh:
        ini.write(fh, space_around_delimiters=True)

    subprocess.run(["spicetify", "config", "current_theme", "text"], check=False,
                   stdout=subprocess.DEVNULL)
    subprocess.run(["spicetify", "config", "color_scheme", SCHEME], check=False,
                   stdout=subprocess.DEVNULL)
    subprocess.run(["spicetify", "config", "inject_theme_js", "1", "replace_colors", "1"],
                   check=False, stdout=subprocess.DEVNULL)

    origin = "pinned" if pinned else "from the bar"
    # flush: stdout is block-buffered when piped, so without this the summary
    # lands after spicetify's own output rather than before it.
    print(f"text / [{SCHEME}]: {flavour}, accent {accent} ({origin}, #{hi})"
          f"{'  +transparent' if transparent else ''}", flush=True)

    # Colour changes ride on CSS variables and need no reload. A transparency
    # toggle rewrites the stylesheet itself, so the page has to re-read it —
    # location.reload() reloads the web view only, and Spotify's audio is in
    # the native process, so playback carries straight on.
    if "--reload" in sys.argv:
        subprocess.run(["spicetify", "-n", "refresh"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        cdp = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spotify-cdp")
        subprocess.run([cdp, "location.reload()"], capture_output=True)
        print("stylesheet refreshed and the client reloaded", flush=True)

    if "--live" in sys.argv:
        live(palette, hi)

    if "--apply" in sys.argv:
        print("patching xpui — takes about half a minute", flush=True)
        # -n: never let spicetify restart Spotify out from under playback.
        subprocess.run(["spicetify", "-n", "apply"], check=False)
        print("done — systemctl --user restart spotify-spiced", flush=True)


def live(palette, hi):
    """Restyle the running client in place, over the devtools protocol.

    Every --spice-* variable is set, not just the thirteen the [bar] scheme
    names: the rest were generated by the last `spicetify apply` from whatever
    flavour was current then, and would otherwise be left behind when the
    flavour changes.

    Inline styles on documentElement are :root with higher specificity than the
    stylesheet's own :root block, so these win without touching a file.
    """
    p = palette
    colours = {
        "accent": hi, "accent-active": hi, "accent-inactive": p["base"],
        "banner": hi, "border-active": hi, "border-inactive": p["surface0"],
        "button": hi, "button-active": hi, "button-disabled": p["surface2"],
        "card": p["mantle"], "header": p["surface2"], "highlight": p["surface2"],
        "highlight-elevated": p["surface1"], "main": p["base"],
        "main-elevated": p["mantle"], "misc": p["overlay0"],
        "notification": p["blue"], "notification-error": p["red"],
        "player": p["crust"], "selected-row": p["subtext0"], "shadow": p["crust"],
        "sidebar": p["crust"], "subtext": p["subtext0"], "tab-active": p["surface0"],
        "text": p["text"],
    }

    js = (
        "(()=>{const c=" + json.dumps(colours) + ";"
        "const s=document.documentElement.style;"
        "for(const [k,v] of Object.entries(c)){"
        "s.setProperty('--spice-'+k,'#'+v);"
        "s.setProperty('--spice-rgb-'+k,[0,2,4].map(i=>parseInt(v.substr(i,2),16)).join(','));"
        "}return Object.keys(c).length;})()"
    )

    cdp = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spotify-cdp")
    res = subprocess.run([cdp, js], capture_output=True, text=True)
    if res.returncode != 0:
        print(f"live restyle failed: {res.stderr.strip()}", file=sys.stderr, flush=True)
        print("  (is Spotify running? the devtools port only opens at launch)",
              file=sys.stderr, flush=True)
        return

    print(f"live: {res.stdout.strip()} variables pushed to the running client", flush=True)

    # The inline styles die with the page. Refresh writes the new colours into
    # the theme's own CSS so the next launch starts correct — it only rewrites
    # colours and styles, so it is seconds rather than the full apply.
    subprocess.run(["spicetify", "-n", "refresh"], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
